FROM python:3.12-alpine3.21
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set environment variables
ENV PATH="/home/devuser/.local/bin:/workspaces/.venv/bin:$PATH"
ENV UV_LINK_MODE="copy"

# Set the shell to /bin/ash and enable pipefail
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# Install dependencies
RUN apk update \
  && apk add --no-cache curl git make vim

# Create a non-root user without a password
RUN adduser -D -h /home/devuser -s /bin/sh devuser \
  && chown -R devuser:devuser /home/devuser

# Switch to the devuser
USER devuser
WORKDIR /workspaces
ENV EDITOR=vim

RUN echo 'alias ll="ls -lha"' >> ~/.bashrc

CMD ["sh"]
