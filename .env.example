# Oremi Ojọ Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_OJO_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
OREMI_OJO_SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
OREMI_OJO_SERVER_PORT=1777

# API prefix/root path for deployments behind a reverse proxy.
OREMI_OJO_API_PREFIX=/

# -- HTTP Settings ---------------------------------------------------------------
# Global timeout in seconds for outbound HTTP calls to external providers.
OREMI_OJO_HTTP_REQUEST_TIMEOUT=30.0

# User-Agent header sent to external HTTP services such as Nominatim.
OREMI_OJO_HTTP_USER_AGENT=oremi-ojo/3.0.0-beta12 (https://gitlab.com/demsking/oremi-ojo)

# External HTTP cache TTL in seconds. The default tracks the fastest
# hourly weather data refresh cadence used by weather, air-quality, and pollen data.
OREMI_OJO_HTTP_CACHE_TTL_SECONDS=3600.0

# -- LLM Settings ----------------------------------------------------------------
# Fully qualified Pydantic AI model identifier.
# Use ollama:<model-name> for an Ollama-backed model.
OREMI_OJO_LLM_MODEL=ollama:qwen3.5:2b

# Timeout in seconds for LLM requests.
OREMI_OJO_LLM_REQUEST_TIMEOUT=15

# Sampling temperature used by the configured LLM backend.
OREMI_OJO_LLM_TEMPERATURE=0.3

# Maximum number of generated LLM response tokens.
OREMI_OJO_LLM_MAX_RESPONSE_TOKENS=500

# System prompt for the agent. Leave unset to use the bundled prompt.
# OREMI_OJO_LLM_SYSTEM_PROMPT=

# -- LLM Cache Settings ----------------------------------------------------------
# Enable the bounded in-memory cache for repeated LLM and idempotent component calls.
OREMI_OJO_LLM_CACHE_ENABLED=true

# Maximum number of internal LLM cache entries kept in memory. Set to 0 to disable caching.
OREMI_OJO_LLM_CACHE_MAX_ENTRIES=512

# TTL in seconds for cacheable internal LLM calls.
OREMI_OJO_LLM_CACHE_TTL_SECONDS=300.0

# -- Ollama Settings -------------------------------------------------------------
# Ollama base URL. Required only when OREMI_OJO_LLM_MODEL starts with ollama:.
# Must be explicitly configured; there is no default.
OREMI_OJO_OLLAMA_BASE_URL=http://localhost:11434

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_OJO_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# OREMI_OJO_LOG_FILE=/var/log/oremi-ojo.log
