# Oremi Ojọ Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_OJO_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
OREMI_OJO_SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
OREMI_OJO_SERVER_PORT=1777

# API prefix/root path for deployments behind a reverse proxy.
OREMI_OJO_API_PREFIX=/

# User-Agent header sent to external HTTP services such as Nominatim.
OREMI_OJO_USER_AGENT=oremi-ojo/3.0.0-beta12 (https://gitlab.com/demsking/oremi-ojo)

# -- LLM Settings ----------------------------------------------------------------
# Fully qualified Pydantic AI model identifier.
# Use ollama:<model-name> for an Ollama-backed model.
OREMI_OJO_LLM_MODEL=ollama:qwen3.5:2b

# Ollama base URL. Required only when OREMI_OJO_LLM_MODEL starts with ollama:.
# Must be explicitly configured; there is no default.
OREMI_OJO_OLLAMA_BASE_URL=http://localhost:11434

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_OJO_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# OREMI_OJO_LOG_FILE=/var/log/oremi-ojo.log
